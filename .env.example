# SDVC-app 환경변수 틀 — 값은 절대 이 파일에 채우지 않는다 (헌장 보안 규칙)
# 실제 값은 로컬 .env.local 과 Vercel 프로젝트 환경변수에 직접 입력한다.
# (.env.local은 .gitignore에 의해 커밋되지 않는다)

# Supabase — [P2-3]. 대시보드 Settings > API Keys에서 확인
# 예전 명칭: anon key(공개키) / service_role key(비밀키)
# 새 명칭: publishable key(공개키) / secret key(비밀키) — 대시보드에 보이는 이름 그대로 넣으면 됨
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic — [P3-1]에서 사용
ANTHROPIC_API_KEY=

# 서버관리자 자동 부여 — [P2-7], FR-024
ADMIN_EMAIL=

# Stripe — Phase 6 결제 [P6-1]. 모두 **테스트 모드** 값으로 시작한다.
#
#   1) 비밀키 sk_test_...  : Stripe 대시보드 > 개발자 > API 키 > Secret key
#      → 서버만 쓴다. 절대 NEXT_PUBLIC_ 접두어를 붙이지 말 것(브라우저로 새어나간다)
STRIPE_SECRET_KEY=
#
#   2) 웹훅 서명키 whsec_... : [P6-6]에서 웹훅 엔드포인트를 만든 뒤 발급받는다.
#      결제 알림이 진짜 Stripe가 보낸 것인지 검증하는 데 쓴다(위변조 방지)
STRIPE_WEBHOOK_SECRET=
#
#   3) 요금제별 가격 ID price_... : Stripe에서 상품을 만들면 가격마다 생긴다.
#      기본 $12/월, 프로 $35/월 (FR-028, 게이트 G2)
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# 예약 작업 열쇠 — [P6-7b]. 하루 한 번 도는 정리 작업(/api/cron/lifecycle)을
# 아무나 부르지 못하게 막는다. 아무 긴 무작위 문자열이면 된다.
CRON_SECRET=

# 사용자(방문자) API 키 암호화 열쇠 — [P11-1], [P11-4]. 각 사용자가 자기
# 명의의 Anthropic API 키를 등록하면 이 값으로 암호화해서 저장한다(과금은
# 그 사용자 본인에게 나간다 — 이 서버나 개발자에게 나가지 않는다).
# 아무 긴 무작위 문자열이면 된다(예: openssl rand -hex 32). CRON_SECRET과
# 같은 값을 재사용하지 말 것 — 용도가 다른 비밀값을 섞으면 하나가 새면 둘 다 샌다.
SITE_API_KEY_ENCRYPTION_SECRET=

# SDVC 수강생 OpenAI 키 전용 AES-256-GCM 키. 위 방문자용 키와 반드시 분리한다.
# KEY는 32바이트 무작위 값을 base64로 인코딩하고, VERSION은 회전 시 바꿀 식별자다.
OPENAI_CREDENTIAL_ENCRYPTION_KEY=
OPENAI_CREDENTIAL_ENCRYPTION_KEY_VERSION=

# Vercel Preview의 실제 Sandbox 실행 스위치 — T034.
# 비용·쿼터 확인 전에는 비워둔다. 앱은 VERCEL_ENV=preview이면서 이 값이 true일
# 때만 Workflow/Sandbox 실행을 큐에 넣는다. Production에서는 true여도 실행하지 않는다.
ENABLE_VERCEL_SANDBOX=

# 사용자(방문자) 세션 서명 열쇠 — [P11-2]. 개발자 계정은 Supabase Auth가
# 세션을 관리하지만, 사용자는 별도 체계라 이 서버가 직접 쿠키에 서명한다
# (HMAC-SHA256). 위 SITE_API_KEY_ENCRYPTION_SECRET과도 다른 값을 쓸 것 —
# 세션 위조와 API 키 유출은 서로 다른 사고이고, 열쇠를 나누면 하나가
# 새도 다른 하나는 안전하다. 아무 긴 무작위 문자열이면 된다.
SITE_SESSION_SECRET=
