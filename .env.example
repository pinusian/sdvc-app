# SDVC-app 환경변수 틀 — 값은 절대 이 파일에 채우지 않는다 (헌장 보안 규칙)
# 실제 값은 로컬 .env.local 과 Vercel 프로젝트 환경변수에 직접 입력한다.
# (.env.local은 .gitignore에 의해 커밋되지 않는다)

# Supabase — [P2-3]. 대시보드 Settings > API Keys에서 확인
# 예전 명칭: anon key(공개키) / service_role key(비밀키)
# 새 명칭: publishable key(공개키) / secret key(비밀키) — 대시보드에 보이는 이름 그대로 넣으면 됨
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic — [P3-1]에서 사용
ANTHROPIC_API_KEY=

# 서버관리자 자동 부여 — [P2-7], FR-024
ADMIN_EMAIL=

# Stripe — Phase 6 결제 [P6-1]. 모두 **테스트 모드** 값으로 시작한다.
#
#   1) 비밀키 sk_test_...  : Stripe 대시보드 > 개발자 > API 키 > Secret key
#      → 서버만 쓴다. 절대 NEXT_PUBLIC_ 접두어를 붙이지 말 것(브라우저로 새어나간다)
STRIPE_SECRET_KEY=
#
#   2) 웹훅 서명키 whsec_... : [P6-6]에서 웹훅 엔드포인트를 만든 뒤 발급받는다.
#      결제 알림이 진짜 Stripe가 보낸 것인지 검증하는 데 쓴다(위변조 방지)
STRIPE_WEBHOOK_SECRET=
#
#   3) 요금제별 가격 ID price_... : Stripe에서 상품을 만들면 가격마다 생긴다.
#      기본 $12/월, 프로 $35/월 (FR-028, 게이트 G2)
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# 예약 작업 열쇠 — [P6-7b]. 하루 한 번 도는 정리 작업(/api/cron/lifecycle)을
# 아무나 부르지 못하게 막는다. 아무 긴 무작위 문자열이면 된다.
CRON_SECRET=
