# SDVC-app 환경변수 틀 — 값은 절대 이 파일에 채우지 않는다 (헌장 보안 규칙)
# 실제 값은 로컬 .env.local 과 Vercel 프로젝트 환경변수에 직접 입력한다.

# Supabase — [P2-3]에서 사용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — [P3-1]에서 사용
ANTHROPIC_API_KEY=

# 서버관리자 자동 부여 — [P2-7], FR-024
ADMIN_EMAIL=

# Stripe — Phase 6에서 사용
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
